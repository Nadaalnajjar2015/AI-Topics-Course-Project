# Copy this file to .env and fill it in. Never commit .env.
ACTIVE_TEMPLATE=payments     # payments | university
TEMPLATES_DIR=part1_templates/templates
LLM_PROVIDER=fake            # fake | ollama | anthropic | openai | groq
LLM_MODEL=qwen2.5:7b         # model name for the chosen provider
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# GroqCloud: set LLM_PROVIDER=groq and LLM_MODEL=openai/gpt-oss-20b
# Keep the actual key only in your ignored .env or environment.
CHROMA_DIR=runtime/chroma
APP_DB=runtime/app.db
